# Cloudflare Pages headers for links.lbdluxe.com
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Baseline security headers for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite emits content-hashed filenames here, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted webfonts (stable, versioned filenames).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The SPA entry must always revalidate so new deploys are picked up instantly.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The web app manifest for the card PWA. The content type is set explicitly
# because the browser refuses to install a PWA whose manifest is served as
# anything other than application/manifest+json.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# The service worker must never be cached. A cached worker is how updates
# silently fail to reach PWA instances that are already installed.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# PWA icons.
/icons/*
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *
